{
  "name": "@maintainerkit/git-integration",
  "version": "0.1.0",
  "description": "Local filesystem and git adapter producing provider-neutral repository snapshots",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@maintainerkit/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
