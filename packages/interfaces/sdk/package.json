{
  "name": "@maintainerkit/sdk",
  "version": "0.1.0",
  "description": "Stable programmatic API for MaintainerKit: policy evaluation, auditing, and report rendering",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@maintainerkit/audit": "workspace:*",
    "@maintainerkit/contribspec": "workspace:*",
    "@maintainerkit/core": "workspace:*",
    "@maintainerkit/git-integration": "workspace:*",
    "@maintainerkit/policy-engine": "workspace:*",
    "@maintainerkit/workflow-engine": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
