{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["CI", "NODE_ENV", "GITHUB_TOKEN", "MAINTAINERKIT_ALLOW_WRITE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
